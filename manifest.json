{
  "manifest_version": 3,
  "name": "Gogeta's Ad Blocker",
  "version": "2.0.0",
  "description": "Blocks requests to common ad networks and hides recognizable ad placements as pages load.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_title": "Gogeta's Ad Blocker is active"
  }
}
